# 이 파일을 .env 로 복사해서 값만 바꿔 쓰세요.  (cp .env.example .env)

# ---------- API 서버 ----------
# 0.0.0.0 : 와이파이/핫스팟 등 모든 네트워크에서 접속 허용 (권장)
HOST=0.0.0.0
PORT=8000
# 프론트 접속 허용 Origin (쉼표로 구분). 해커톤 중엔 * 로 다 열어둬도 됨
CORS_ORIGINS=*

# ---------- 챗봇 (답변 생성 서버) ----------
# 답변 생성 서버 주소 (팀원 PC의 IP). 비워두면 봇 호출 안 함
ANSWER_SERVER_URL=http://192.168.x.x:8000
# 채팅에 이 단어가 들어 있으면 봇 호출
BOT_TRIGGER=@톡스픽,@봇
# 답변 생성 서버가 답변을 저장할 때 쓰는 user_name (이 이름의 메시지는 봇을 다시 부르지 않음)
BOT_NAME=톡스픽
# 이 이름으로 온 메시지도 봇으로 보고 BOT_NAME 으로 저장 (답변 서버가 예전 이름으로 보내도 됨)
BOT_ALIASES=봇
# 봇에게 넘길 최근 대화 개수
CONTEXT_MESSAGES=20
# 답변 서버 접수 대기 시간(초)
ANSWER_TIMEOUT=10

# ---------- 예약 (쩝쩝박사 MCP 서버) ----------
# MCP 서버 주소 (팀원 PC의 IP). 비워두면 MCP 호출 없이 예약만 저장하고 안내 메시지는 이 서버가 만듦
MCP_SERVER_URL=http://192.168.x.x:8100
MCP_TIMEOUT=10

# ---------- MySQL ----------
# 서버 PC에서 실행할 땐 localhost 그대로.
# 다른 팀원 PC에서 이 서버를 돌리거나 DB에 붙을 땐 → MySQL이 깔린 PC의 IP (같은 와이파이 기준, 예: 192.168.x.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=kakao_app
DB_PASSWORD=여기에_비밀번호
DB_NAME=kakao_chatbot
# 데모 식당 목록 폴더(안의 *.json 전부) 또는 파일. 봇 답변에 이 식당 이름이 나오면 "@톡스픽 예약해줘"로 예약
PLACES_FILE=places

# ---------- placelist (카카오맵 목업) ----------
# 예약이 생기거나 취소되면 이 서버의 POST /api/reservation 으로 알려 리스트 온도에 반영. 비워두면 안 보냄
PLACELIST_URL=http://192.168.x.x:8200
# 식당 목록 파일 → placelist 리스트 id (마포 리스트 → M01, 서초 → S01, 부산 1 → B02, 부산 2 → B01)
PLACELIST_LISTS=mapo:M01,seocho:S01,busan_1:B02,busan_2:B01
