# 이 파일을 .env 로 복사해서 값만 바꿔 쓰세요.  (cp .env.example .env)

# ---------- API 서버 ----------
# 0.0.0.0 : 핫스팟/와이파이 등 모든 네트워크에서 접속 허용 (권장)
HOST=0.0.0.0
PORT=8000
# 프론트 접속 허용 Origin (쉼표로 구분). 해커톤 중엔 * 로 다 열어둬도 됨
CORS_ORIGINS=*

# ---------- MySQL ----------
# 서버 PC에서 실행할 땐 localhost 그대로.
# 다른 팀원 PC에서 이 서버를 돌리거나 DB에 붙을 땐 → MySQL이 깔린 PC의 핫스팟 IP
DB_HOST=localhost
DB_PORT=3306
DB_USER=kakao_app
DB_PASSWORD=여기에_비밀번호
DB_NAME=kakao_chatbot
